# Copy to users.acl on the server and set strong passwords:
#   cp users.acl.example users.acl
#
# Format: user <name> on >password ~* &* +@all
#   ~*  = all keys
#   &*  = all pub/sub channels
#   +@all = all commands (use +@read for read-only)

user default on sanitize-payload >CHANGE_DEFAULT_PASSWORD ~* &* +@all
user app1 on sanitize-payload >CHANGE_APP1_PASSWORD ~* &* +@all
user app2 on sanitize-payload >CHANGE_APP2_PASSWORD ~* &* +@all
